#!/bin/bash -p
# cartopian-claude — Cartopian wrapper for the Claude Code CLI.
#
# Usage:  cartopian-claude <absolute-prompt-path>
#
# Reads the prompt file and passes its content to `claude -p` with
# non-interactive flags. Edit the Configuration section below to change
# allowed tools, output format, and other tool-specific settings.
#
# Exit codes:
#   0   — claude completed successfully
#   1   — wrapper error (missing file, missing CLI, bad arguments)
#   *   — upstream claude exit code

set -euo pipefail

# --- Status-file helper (early-crash signal for wait-handoff) --------
# Source the shared helper that emits <report-path>.status on assignee
# exit. Optional: if the helper is missing, degrade to no-op stubs so the
# wrapper still runs (the status file is never a hard requirement).
_CARTOPIAN_WRAPPER_SOURCE="${BASH_SOURCE[0]}"
case "$_CARTOPIAN_WRAPPER_SOURCE" in
  */*) _CARTOPIAN_WRAPPER_PARENT="${_CARTOPIAN_WRAPPER_SOURCE%/*}" ;;
  *) _CARTOPIAN_WRAPPER_PARENT="." ;;
esac
_CARTOPIAN_WRAPPER_DIR="$(cd -P -- "$_CARTOPIAN_WRAPPER_PARENT" && pwd)"
_CARTOPIAN_STATUS_HELPER_PRESENT=false
if [[ -f "${_CARTOPIAN_WRAPPER_DIR}/_cartopian-status.sh" ]]; then
  _CARTOPIAN_STATUS_HELPER_PRESENT=true
  # shellcheck source=_cartopian-status.sh
  source "${_CARTOPIAN_WRAPPER_DIR}/_cartopian-status.sh"
else
  cartopian_status_path() { echo ""; }
  cartopian_write_status() { return 0; }
  cartopian_report_complete() { return 1; }
  cartopian_run_supervised() { shift; "$@"; CARTOPIAN_ASSIGNEE_EXIT=$?; return 0; }
fi
# --------------------------------------------------------------------

# --- Configuration ---------------------------------------------------
# Allowed tools (comma-separated). RESTRICTS which tools claude can use.
# Empty (default) means claude uses its full default tool set, which is
# what an autonomous coder/reviewer handoff needs (Read, Write, Edit,
# Bash, Glob, Grep, etc.).
#   ""               — full default tool set (matches autonomous posture)
#   Read,Write,Bash  — narrow whitelist
#   Read             — read-only
CLAUDE_ALLOWED_TOOLS="${CARTOPIAN_CLAUDE_TOOLS:-}"

# Output format: "text" | "json" | "stream-json"
CLAUDE_OUTPUT_FORMAT="${CARTOPIAN_CLAUDE_FORMAT:-text}"

# Use --bare to skip auto-discovery of hooks/plugins (faster startup).
# Hook-enabled Cartopian launches reject bare mode because Claude suppresses
# even explicit settings-file/flag hooks under --bare.
CLAUDE_BARE="${CARTOPIAN_CLAUDE_BARE:-false}"

# Skip all permission prompts so claude runs non-interactively. Without
# this, claude will hang waiting on TTY input the first time it tries
# to write a file or run a shell command. This matches the autonomy
# posture of cartopian-codex (workspace-write sandbox) and
# cartopian-agy (--dangerously-skip-permissions). Set to "false" to
# re-enable permission prompts (only useful for interactive debugging).
CLAUDE_SKIP_PERMISSIONS="${CARTOPIAN_CLAUDE_SKIP_PERMS:-true}"
# ------------------------------------------------------------------

readonly PROMPT_PATH="${1:-}"

if [[ -z "$PROMPT_PATH" ]]; then
  echo "cartopian-claude: error: missing prompt path argument" >&2
  echo "usage: cartopian-claude <absolute-prompt-path>" >&2
  exit 1
fi

if [[ ! -f "$PROMPT_PATH" ]]; then
  echo "cartopian-claude: error: prompt file not found: $PROMPT_PATH" >&2
  exit 1
fi

_CARTOPIAN_HOOK_BOUND=false
if [[ -n "${CARTOPIAN_ROLE:-}" || -n "${CARTOPIAN_EXPECTED_REPORT_PATH:-}" ]]; then
  _CARTOPIAN_HOOK_BOUND=true
fi
if [[ "$_CARTOPIAN_HOOK_BOUND" == "true" && "$_CARTOPIAN_STATUS_HELPER_PRESENT" != "true" ]]; then
  echo "cartopian-claude: error: hook-enabled launches require the installed status/supervisor helper: ${_CARTOPIAN_WRAPPER_DIR}/_cartopian-status.sh" >&2
  exit 1
fi

_CARTOPIAN_CLAUDE_EXECUTABLE="${CARTOPIAN_CLAUDE_EXECUTABLE:-}"
if [[ "$_CARTOPIAN_HOOK_BOUND" == "true" ]]; then
  if [[ "${CARTOPIAN_LAUNCH_CWD:-}" != /* || ! -d "$CARTOPIAN_LAUNCH_CWD" ]]; then
    echo "cartopian-claude: error: hook-enabled launches require an absolute, existing CARTOPIAN_LAUNCH_CWD from cartopian dispatch" >&2
    exit 1
  fi
  if [[ "$PROMPT_PATH" != /* ]]; then
    echo "cartopian-claude: error: hook-enabled launches require an absolute prompt path from cartopian dispatch" >&2
    exit 1
  fi
  if [[ -z "$_CARTOPIAN_CLAUDE_EXECUTABLE" || "$_CARTOPIAN_CLAUDE_EXECUTABLE" != /* || ! -f "$_CARTOPIAN_CLAUDE_EXECUTABLE" || ! -x "$_CARTOPIAN_CLAUDE_EXECUTABLE" ]]; then
    echo "cartopian-claude: error: hook-enabled launches require an absolute executable CARTOPIAN_CLAUDE_EXECUTABLE from cartopian dispatch" >&2
    exit 1
  fi
  _CARTOPIAN_PYTHON="${CARTOPIAN_PYTHON:-}"
  if [[ -z "$_CARTOPIAN_PYTHON" || "$_CARTOPIAN_PYTHON" != /* || ! -f "$_CARTOPIAN_PYTHON" || ! -x "$_CARTOPIAN_PYTHON" ]]; then
    echo "cartopian-claude: error: hook-enabled launches require an absolute executable CARTOPIAN_PYTHON from cartopian dispatch" >&2
    exit 1
  fi
elif [[ -z "$_CARTOPIAN_CLAUDE_EXECUTABLE" ]]; then
  _CARTOPIAN_CLAUDE_EXECUTABLE="$(command -v claude || true)"
  if [[ -n "$_CARTOPIAN_CLAUDE_EXECUTABLE" && "$_CARTOPIAN_CLAUDE_EXECUTABLE" != /* ]]; then
    _CARTOPIAN_CLAUDE_EXECUTABLE="$PWD/${_CARTOPIAN_CLAUDE_EXECUTABLE#./}"
  fi
fi
if [[ -z "$_CARTOPIAN_CLAUDE_EXECUTABLE" || "$_CARTOPIAN_CLAUDE_EXECUTABLE" != /* || ! -f "$_CARTOPIAN_CLAUDE_EXECUTABLE" || ! -x "$_CARTOPIAN_CLAUDE_EXECUTABLE" ]]; then
  echo "cartopian-claude: error: underlying Claude executable is missing, non-absolute, or not executable" >&2
  echo "Install Claude Code and launch through cartopian dispatch" >&2
  exit 1
fi
export CARTOPIAN_CLAUDE_EXECUTABLE="$_CARTOPIAN_CLAUDE_EXECUTABLE"

# --- Launch directory ------------------------------------------------
# Assignee CLIs run with cwd set to the Cartopian project root (the
# registered project path). Prompts always live at
# <workspace>/projects/<project-id>/prompts/PROMPT-*.md, so the project
# root is derivable from the prompt path alone.
#
# Override: set CARTOPIAN_LAUNCH_CWD to an absolute or relative path to
# skip auto-resolution. Useful for split-layout, cross-drive, monorepo,
# or per-repo-sandbox setups. A non-existent path is a hard error, not
# a silent fallback.
if [[ "$_CARTOPIAN_HOOK_BOUND" == "true" ]]; then
  LAUNCH_CWD="$CARTOPIAN_LAUNCH_CWD"
  cd "$LAUNCH_CWD"
  PROMPT_PATH_ABS="$PROMPT_PATH"
  echo "cartopian-claude: cwd=$LAUNCH_CWD (dispatch boundary)" >&2
elif [[ -n "${CARTOPIAN_LAUNCH_CWD:-}" ]]; then
  if [[ ! -d "$CARTOPIAN_LAUNCH_CWD" ]]; then
    echo "cartopian-claude: CARTOPIAN_LAUNCH_CWD='$CARTOPIAN_LAUNCH_CWD' is not a directory" >&2
    exit 1
  fi
  LAUNCH_CWD="$(cd "$CARTOPIAN_LAUNCH_CWD" && pwd)"
  cd "$LAUNCH_CWD"
  PROMPT_PATH_ABS="$(cd "$(dirname "$PROMPT_PATH")" && pwd)/$(basename "$PROMPT_PATH")"
  echo "cartopian-claude: cwd=$LAUNCH_CWD (CARTOPIAN_LAUNCH_CWD override)" >&2
else
  PROMPT_ABS="$(cd "$(dirname "$PROMPT_PATH")" && pwd)/$(basename "$PROMPT_PATH")"
  PROMPTS_DIR="$(dirname "$PROMPT_ABS")"
  PROJECT_DIR="$(dirname "$PROMPTS_DIR")"
  # Launch-cwd: trigger when basename("$PROMPTS_DIR")) == "prompts"
  if [[ "$(basename "$PROMPTS_DIR")" == "prompts" ]]; then
    cd "$PROJECT_DIR"
    echo "cartopian-claude: cwd=$PROJECT_DIR" >&2
  else
    echo "cartopian-claude: prompt is outside a Cartopian project layout; leaving cwd unchanged (set CARTOPIAN_LAUNCH_CWD to override)" >&2
  fi
  PROMPT_PATH_ABS="$PROMPT_ABS"
fi
# --------------------------------------------------------------------

CMD=("$_CARTOPIAN_CLAUDE_EXECUTABLE" -p)

# Build one compact JSON argument for Claude's additional per-launch settings
# layer. CARTOPIAN_ROLE is exported only by mediated dispatch and asks the
# helper to resolve capability activation from the same role/config boundary
# claude_hook.py enforces. CARTOPIAN_EXPECTED_REPORT_PATH independently asks
# for completion enforcement. An activated capability boundary disables every
# filesystem settings source at launch: user/project/plugin
# hooks execute outside the Bash sandbox, and Claude otherwise discovers and
# hot-reloads new project settings after a cwd change. Managed policy and this
# explicit process settings object remain active. Claude suppresses
# even explicit process settings hooks under --bare, so a hook-enabled launch
# refuses that mode. Refuse before launch if the installed helper/hook chain is
# missing, invalid, or conflicts with a stale registration.
if [[ -n "${CARTOPIAN_ROLE:-}" || -n "${CARTOPIAN_EXPECTED_REPORT_PATH:-}" ]]; then
  _CARTOPIAN_INSTALL_ROOT="$(cd -P -- "${_CARTOPIAN_WRAPPER_DIR}/../.." && pwd)"
  _CARTOPIAN_SETTINGS_HELPER="${_CARTOPIAN_INSTALL_ROOT}/cli/claude_launch_settings.py"
  if [[ ! -f "$_CARTOPIAN_SETTINGS_HELPER" ]]; then
    echo "cartopian-claude: error: Claude settings helper not found: $_CARTOPIAN_SETTINGS_HELPER" >&2
    exit 1
  fi
  _CARTOPIAN_SETTINGS_ARGS=(
    "$_CARTOPIAN_SETTINGS_HELPER"
    --install-root "$_CARTOPIAN_INSTALL_ROOT"
    --project-dir "$PWD"
    --platform posix
  )
  [[ -n "${CARTOPIAN_ROLE:-}" ]] && _CARTOPIAN_SETTINGS_ARGS+=(--capability)
  [[ -n "${CARTOPIAN_EXPECTED_REPORT_PATH:-}" ]] && _CARTOPIAN_SETTINGS_ARGS+=(--completion)
  if ! "$_CARTOPIAN_PYTHON" -I -S "${_CARTOPIAN_SETTINGS_ARGS[@]}" --preflight-only >/dev/null; then
    echo "cartopian-claude: error: pre-containment Claude launch validation failed" >&2
    exit 1
  fi
  if ! _CARTOPIAN_CLAUDE_VERSION="$("$_CARTOPIAN_CLAUDE_EXECUTABLE" --version 2>&1)"; then
    echo "cartopian-claude: error: could not determine Claude Code version" >&2
    exit 1
  fi
  _CARTOPIAN_SETTINGS_ARGS+=(--claude-version "$_CARTOPIAN_CLAUDE_VERSION")
  if ! _CARTOPIAN_CLAUDE_SETTINGS="$("$_CARTOPIAN_PYTHON" -I -S "${_CARTOPIAN_SETTINGS_ARGS[@]}")"; then
    echo "cartopian-claude: error: could not construct process-scoped Claude hook settings" >&2
    exit 1
  fi
  if [[ "$_CARTOPIAN_CLAUDE_SETTINGS" != "{}" ]]; then
    if [[ "$CLAUDE_BARE" == "true" ]]; then
      echo "cartopian-claude: error: CARTOPIAN_CLAUDE_BARE=true suppresses required process-scoped hooks" >&2
      exit 1
    fi
    if [[ "$_CARTOPIAN_CLAUDE_SETTINGS" == *'"PreToolUse":'* ]]; then
      # Capability matching covers Claude's built-in tools. Do not admit
      # user/plugin MCP tools that could expose an unclassified filesystem
      # mutation surface outside the hook and shell sandbox. Delegated agents
      # and worktree relocation can likewise move execution or mutate shared
      # Git metadata outside the captured boundary.
      CMD+=(--strict-mcp-config --disallowedTools "Agent,Task,EnterWorktree,ExitWorktree,TeamCreate,TeamDelete,CronCreate,CronDelete,CronList,SendMessage,SendFile,RemoteTrigger")
      # No user/project/local source: command hooks and plugin hooks run with
      # the operator's full permissions, outside Claude's Bash sandbox. The
      # empty argument is Claude's documented filesystem-settings isolation.
      CMD+=(--setting-sources "")
      export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
    fi
    CMD+=(--settings "$_CARTOPIAN_CLAUDE_SETTINGS")
  fi
fi

# Derive the optional status-file path only after pre-containment validation.
# Dispatch supplies the exact report path, so mediated launches return from
# this helper without invoking any PATH-resolved utility.
STATUS_PATH="$(cartopian_status_path "$PROMPT_PATH")"

if [[ -n "$CLAUDE_ALLOWED_TOOLS" ]]; then
  CMD+=(--allowedTools "$CLAUDE_ALLOWED_TOOLS")
fi

if [[ "$CLAUDE_OUTPUT_FORMAT" != "text" ]]; then
  CMD+=(--output-format "$CLAUDE_OUTPUT_FORMAT")
fi

if [[ "$CLAUDE_BARE" == "true" ]]; then
  CMD+=(--bare)
fi

if [[ "$CLAUDE_SKIP_PERMISSIONS" == "true" ]]; then
  CMD+=(--dangerously-skip-permissions)
fi

# Agent-neutral model selection: dispatch exports CARTOPIAN_MODEL from the
# resolved dispatch model; translate it into claude's --model flag.
# Unset means claude's own default model.
if [[ -n "${CARTOPIAN_MODEL:-}" ]]; then
  CMD+=(--model "$CARTOPIAN_MODEL")
fi

# Agent-neutral effort selection: dispatch exports CARTOPIAN_EFFORT from the
# resolved dispatch effort; translate it into claude's --effort flag.
# Values outside claude's CLI-wide effort vocabulary fall back to the default
# effort (warn + omit). A vocabulary-valid level a specific model rejects is
# passed through — that outcome is the tool's own behavior. The vocabulary
# tracks the installed claude CLI generation and may drift as it evolves.
if [[ -n "${CARTOPIAN_EFFORT:-}" ]]; then
  EFFORT_LC="$(printf '%s' "$CARTOPIAN_EFFORT" | tr '[:upper:]' '[:lower:]')"
  case "$EFFORT_LC" in
    low|medium|high|xhigh|max)
      CMD+=(--effort "$EFFORT_LC")
      ;;
    *)
      echo "cartopian-claude: CARTOPIAN_EFFORT=$CARTOPIAN_EFFORT is not a supported claude effort level (low|medium|high|xhigh|max); launching with the default effort" >&2
      ;;
  esac
fi

# Claude 2.1.212+ parses --add-dir as variadic. Keep the positional prompt
# before every --add-dir occurrence so the final variadic option cannot
# consume it as another directory.
CMD+=("$PROMPT_PATH_ABS")

# Work-root grant: dispatch exports CARTOPIAN_WORK_ROOTS (a colon-joined
# list of the project's resolved work-root absolute paths). Declared work
# roots become additional working directories (--add-dir) so writes there are
# in-scope in every permission mode — an explicit grant, not a side effect of
# --dangerously-skip-permissions.
if [[ -n "${CARTOPIAN_WORK_ROOTS:-}" ]]; then
  IFS=':' read -r -a _CARTOPIAN_ROOTS <<< "$CARTOPIAN_WORK_ROOTS"
  for _root in "${_CARTOPIAN_ROOTS[@]}"; do
    [[ -n "$_root" ]] && CMD+=(--add-dir "$_root")
  done
fi

# --- OS-enforced deadline (CARTOPIAN_TIMEOUT) -----------------------
# Prepend `timeout` (or `gtimeout` on macOS) so the OS kills the
# upstream process at the configured deadline (default 60m). The PM
# sets CARTOPIAN_TIMEOUT from the resolved dispatch timeout;
# it does not poll or watchdog the running process. SIGTERM at deadline
# returns exit code 124. See protocol/CONVENTIONS.md → Handoffs.
TIMEOUT_DURATION="${CARTOPIAN_TIMEOUT:-60m}"
# Whether an OS timeout wraps the command — lets the status file distinguish
# a deadline kill (exit 124) from a plain non-zero exit.
TIMEOUT_APPLIED=false
if command -v timeout &>/dev/null; then
  CMD=(timeout "$TIMEOUT_DURATION" "${CMD[@]}")
  TIMEOUT_APPLIED=true
elif command -v gtimeout &>/dev/null; then
  CMD=(gtimeout "$TIMEOUT_DURATION" "${CMD[@]}")
  TIMEOUT_APPLIED=true
else
  echo "cartopian-claude: warning: no 'timeout'/'gtimeout' on PATH; running without OS-enforced deadline (macOS: brew install coreutils)" >&2
  TIMEOUT_DURATION="unbounded"
fi
# --------------------------------------------------------------------

TRACE_TOOLS="${CLAUDE_ALLOWED_TOOLS:-default}"
echo "cartopian-claude: running claude -p (tools=$TRACE_TOOLS, skip-perms=$CLAUDE_SKIP_PERMISSIONS, timeout=$TIMEOUT_DURATION)" >&2

# Run the assignee (not exec) so we can capture its exit outcome and emit
# the optional status file wait-handoff polls for early-crash detection.
#
# cartopian_run_supervised wraps the run with a report-completion supervisor:
# once the authoritative report file appears, a lingering child (MCP stdio /
# trailing turn) is reaped promptly so a finished handoff exits 0/clean instead
# of idling to the CARTOPIAN_TIMEOUT deadline. The deadline (the single SSOT
# timer, applied above via `timeout`) is untouched — a genuine hang that writes
# no report still hits it (exit 124). The watched report path is the status path
# without its ".status" suffix.
REPORT_PATH="${STATUS_PATH%.status}"
[[ "$REPORT_PATH" == "$STATUS_PATH" ]] && REPORT_PATH=""

set +e
cartopian_run_supervised "$REPORT_PATH" "${CMD[@]}"
ASSIGNEE_EXIT=$CARTOPIAN_ASSIGNEE_EXIT
set -e
cartopian_write_status "$STATUS_PATH" "$ASSIGNEE_EXIT" "$TIMEOUT_APPLIED"
exit "$ASSIGNEE_EXIT"
